# Copy to .env.local and adjust. The app and drizzle-kit both read these.

# Local (pnpm db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interviewer

# Supabase (production / preview on Vercel): use the Supavisor *transaction* pooler (port 6543)
# from Project → Connect. Do not add sslmode; SSL is configured by DATABASE_CA_CERT below.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase CA certificate (PEM contents, not a path), from Database Settings → SSL Configuration.
# Leave unset locally. When set, connections use SSL and verify the server certificate.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Supabase Auth (User sign-in), from Project Settings → API Keys. Needed locally too:
# sign-in always goes through the hosted Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ElevenLabs (transcribing Answers), from ElevenLabs → Developers → API Keys. Server-only.
ELEVENLABS_API_KEY=sk_...
